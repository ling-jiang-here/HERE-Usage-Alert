# HERE shared app credentials (canonical names used by this project).
# HERE_REALM_ID is not required: the realm is discovered from the app
# credential via GET /app/me/authorization.
here.client.id=
here.access.key.id=
here.access.key.secret=

# Optional remediation.
HERE_AUTO_DISABLE_APP_CREDENTIALS=false
HERE_LIMIT_APP_TO_WITHIN_FREE_TIER_PROJECT=false

# Optional alerting.
ALERT_WEBHOOK_URL=

# Optional legacy HERE_* forms; the lowercase names above take precedence when
# both are set. HERE_REALM_ID still overrides realm auto-discovery.
# HERE_REALM_ID=
# HERE_CLIENT_ID=
# HERE_MONITOR_ACCESS_KEY_ID=
# HERE_MONITOR_ACCESS_KEY_SECRET=