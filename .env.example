# HERE Usage API credentials. Copy to .env and fill in local values.
HERE_USAGE_API_BASE_URL=https://usage.bam.api.here.com/v2
HERE_REALM_ID=
HERE_USAGE_API_CLIENT_ID=
HERE_USAGE_API_CLIENT_SECRET=
HERE_OAUTH_TOKEN_URL=https://account.api.here.com/oauth2/token
HERE_OAUTH_SCOPE=
# Cost Management Usage API v2 organization endpoint.
HERE_USAGE_API_USAGE_PATH=/usage/realms/{realmId}

# Optional: post anomaly alerts to a generic HTTPS webhook.
ALERT_WEBHOOK_URL=
